# MongoDB Configuration
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/school-management

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Vercel Cron authentication
CRON_SECRET=replace-with-a-random-cron-secret

# Used only when an approved student account is created. Never stored in MongoDB.
STUDENT_DEFAULT_PASSWORD=12345678
TEACHER_DEFAULT_PASSWORD=12341234

# Cloudinary photo configuration (private server variables).
# Never use the NEXT_PUBLIC_ prefix for these values.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Legacy Cloudflare R2 values are only needed to read old photos during migration.
# New student and teacher photos are uploaded to Cloudinary.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-school-photos

# Maximum original upload size. The server compresses accepted photos to about 200 KB.
STUDENT_PHOTO_MAX_UPLOAD_MB=5
TEACHER_PHOTO_MAX_UPLOAD_MB=5

# Application Settings
NODE_ENV=development

# School Configuration (these should be set per deployment)
# These are NOT hardcoded - each school deployment should have its own values

# Monthly Fee (in local currency)
MONTHLY_FEE=5000

# Academic Year
ACADEMIC_YEAR=2026-2027

# School Branding (per deployment)
SCHOOL_NAME=My School
SCHOOL_ADDRESS=123 Education Street
SCHOOL_PHONE=+92-300-1234567
SCHOOL_EMAIL=info@myschool.edu
SCHOOL_DESCRIPTION=A premier educational institution
SCHOOL_PRIMARY_COLOR=#3b82f6
SCHOOL_SECONDARY_COLOR=#1e293b
SCHOOL_TIMEZONE=Asia/Karachi

# Feature Flags
ENABLE_ATTENDANCE_CLEANUP=true
ENABLE_MONTHLY_FEES=true

# WhatsApp auto-send bot (optional). The bot is a separate process started
# with `npm run bot` that holds the linked WhatsApp session (QR scanned once)
# and delivers bulk vouchers automatically with human-like pacing.
# Point this at wherever the bot listens; leave unset to hide the bot UI.
WA_BOT_URL=http://127.0.0.1:3099
# Shared secret for bot API calls. REQUIRED when the bot listens beyond
# localhost (set the same value in .env on the machine running the bot).
WA_BOT_TOKEN=
# Bot pacing (milliseconds / counts) — defaults shown; tune to lower risk.
# WA_BOT_DELAY_MIN_MS=6000
# WA_BOT_DELAY_MAX_MS=15000
# WA_BOT_PAUSE_EVERY=25
# WA_BOT_PAUSE_MIN_MS=60000
# WA_BOT_PAUSE_MAX_MS=120000
# WA_BOT_MAX_PER_RUN=500